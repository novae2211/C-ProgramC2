#include <stdio.h>
int main (void)
{
    int x, y, sum, diff, prod, quot;

    printf("please enter 2 numbers:\n");
    scanf("%d", &x);
    scanf("%d", &y);

        sum = x + y;
        diff = x - y;
        prod = x * y;
        quot = x / y;

        printf("sum:%d\n", sum);
        printf("difference:%d\n", diff);
        printf("product:%d\n", prod);
        printf("quotient:%d\n", quot);

}
